# Copy to .env.local — never commit .env.local

# https://console.groq.com/
GROQ_API_KEY=

# https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (server only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Run supabase/schema.sql in the Supabase SQL editor after creating a project.
# If you used the older auth-required schema, also run supabase/migrations/002_public_enquiries.sql
